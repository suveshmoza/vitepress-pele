{
  "name": "vitepress-pele-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "dev": "vp run docs#dev",
    "docs:build": "vp run docs#build",
    "docs:dev": "vp run docs#dev",
    "docs:preview": "vp run docs#preview",
    "pack": "vp -C packages/vitepress-pele pack",
    "prepare": "vp config",
    "test": "vp run -r test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
